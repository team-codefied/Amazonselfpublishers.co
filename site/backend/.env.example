# Copy to .env (same folder, or one level above public_html) and fill in. NEVER commit the real .env.
MAIL_TO=
MAIL_FROM=
MAIL_FROM_NAME=amazonselfpublishers website
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
APP_SECRET=
ALLOWED_HOSTS=
PHONE_DISPLAY=+1 323 509 3062
# MAIL_TO: inbox that receives inquiries
# MAIL_FROM: a mailbox on your domain, must exist on the SMTP account
# SMTP_SECURE: ssl (port 465), tls (587 STARTTLS) or none (local testing only)
# APP_SECRET: long random string, generate with: php -r "echo bin2hex(random_bytes(32));"
# ALLOWED_HOSTS: optional extra hostnames allowed to post, comma-separated (e.g. yourdomain.com,www.yourdomain.com)
